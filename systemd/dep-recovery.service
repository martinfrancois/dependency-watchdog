[Unit]
Description=Investigate dependency watchdog incidents with Codex
Documentation=https://github.com/martinfrancois/dependency-watchdog
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/env node __REPO_DIR__/src/cli-recovery.ts
Environment=HOME=%h
Environment=DEP_WATCHDOG_CONFIG_DIR=__CONFIG_DIR__
Environment=PATH=__NODE_BIN__:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=DEP_WATCHDOG_RECOVERY=1
TimeoutStartSec=6h
KillMode=control-group
UMask=0077
NoNewPrivileges=true
RestrictSUIDSGID=true

[Install]
WantedBy=default.target
