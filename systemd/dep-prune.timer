[Unit]
Description=Prune matured release-age exclusions weekly
Documentation=https://github.com/martinfrancois/dependency-watchdog

[Timer]
# Thursday, so the list is clean before Friday's lockFileMaintenance window rewrites the lockfiles.
OnCalendar=Thu *-*-* 08:00:00
Persistent=true
RandomizedDelaySec=15min

[Install]
WantedBy=timers.target
