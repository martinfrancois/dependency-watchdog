# Dependency automation watchdog credentials.
# Copy to ~/.config/dep-watchdog/config.env, chmod 600, and fill in.
# install.sh refuses to run while any value is still PLACEHOLDER.

# Telegram -> @BotFather -> /newbot -> copy the token.
TELEGRAM_BOT_TOKEN=PLACEHOLDER

# Leave as AUTO. install.sh resolves it via getUpdates, which requires that you have already
# sent your bot a message: Telegram will not reveal a chat to a bot nobody has spoken to.
TELEGRAM_CHAT_ID=AUTO

# healthchecks.io check, period 1 day, grace 6 hours, integration set to Telegram.
# This is the dead-man's switch: the only component that is neither on this server nor on
# GitHub, and so the only one able to report that they have stopped.
HEALTHCHECKS_PING_URL=PLACEHOLDER
